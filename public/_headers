# Cloudflare Pages response headers.
# Built files have a content hash in their names, so browsers can keep them for good;
# a new build gets new names, so updates still arrive straight away.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The offline helper and app details must be checked on every visit, so updates are found.
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache

# The music never changes; let browsers keep it for a week.
/music/*
  Cache-Control: public, max-age=604800
